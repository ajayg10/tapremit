PORT=3000
NODE_ENV=development
MOCK_CHAIN=true
MOCK_PAYMENT_EXECUTOR=true
MOCK_AUTH=true
MOCK_LLM=true

RPC_PRIMARY_URL=https://testnet-rpc.monad.xyz
RPC_FALLBACK_URL=https://rpc.ankr.com/monad_testnet
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
EXPLORER_BASE_URL=https://testnet.monadvision.com

RELAYER_ADDRESS=0x836DF4117d96B860939627B7288a0e5C51fEFD53
RELAYER_PRIVATE_KEY=

PAUSE_REAL_TRANSFERS=false
MAX_TESTNET_TRANSFER_MON=0.2
GLOBAL_DAILY_LIMIT_MON=2.0
PER_TX_LIMIT_MON=0.1
DAILY_LIMIT_MON=1.0
OPERATOR_OVERRIDE_ALLOW_SENDS=false
MONAD_FINALITY_CONFIRMATION_TIMEOUT_MS=30000
NOT_FOUND_WINDOW_MS=300000
MAX_REBROADCAST_AGE_MS=600000

PER_TX_LIMIT_AUSD=50
DAILY_LIMIT_AUSD=200
PROPOSAL_TTL_SECONDS=900

DB_PATH=./data/tapremit.db
DATABASE_PATH=./data/tapremit.db
DEBUG_SQL=false
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001

# Demo Account Seeding (idempotent on boot)
SEED_ON_BOOT=false
SEED_ALICE_WALLET=0x1111111111111111111111111111111111111111
SEED_RIYA_WALLET=0x2222222222222222222222222222222222222222
SEED_BOB_WALLET=0x3333333333333333333333333333333333333333
SEED_CHARLIE_WALLET=0x4444444444444444444444444444444444444444

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=TapRemit
WEBAUTHN_ORIGIN=http://localhost:3000
JWT_SECRET=mock_secret_for_development_only_123_must_be_32_chars
JWT_EXPIRY=1h
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_IP_RATE_LIMIT_MAX=60
AUTH_IP_RATE_LIMIT_WINDOW_MS=900000
ME_RATE_LIMIT_MAX=120
ME_RATE_LIMIT_WINDOW_MS=60000

