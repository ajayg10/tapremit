PORT=3000
NODE_ENV=development
MOCK_CHAIN=true
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
DB_PATH=./data/tapremit.db
DEBUG_SQL=false
MOCK_AUTH=true
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=TapRemit
WEBAUTHN_ORIGIN=http://localhost:3000
JWT_SECRET=mock_secret_for_development_only_123
JWT_EXPIRY=1h
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_IP_RATE_LIMIT_MAX=60
AUTH_IP_RATE_LIMIT_WINDOW_MS=900000
ME_RATE_LIMIT_MAX=120
ME_RATE_LIMIT_WINDOW_MS=60000
MOCK_LLM=true
MOCK_PAYMENT_EXECUTOR=true
PER_TX_LIMIT_AUSD=50
DAILY_LIMIT_AUSD=200
PROPOSAL_TTL_SECONDS=900
