    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "@types/node-cache": "^4.1.3",
    "@types/uuid": "^10.0.0",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "typescript": "^5.4.5",
